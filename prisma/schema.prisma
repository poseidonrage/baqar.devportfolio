datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Message {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String   @db.Text
  createdAt DateTime @default(now())
}

model VisitorStat {
  id        Int      @id @default(autoincrement())
  page      String
  ip        String?
  userAgent String?
  referrer  String?
  timestamp DateTime @default(now())
}

model Blog {
  id            Int       @id @default(autoincrement())
  title         String
  slug          String    @unique
  content       String    @db.Text
  summary       String?   @db.Text
  published     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  comments      Comment[]
  category      String    @default("Backend")
  readTime      String    @default("5 min read")
  tags          String?   @db.Text
  keyTakeaways  String?   @db.Text
}

model Comment {
  id          Int      @id @default(autoincrement())
  authorName  String
  authorEmail String
  content     String   @db.Text
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now())
  blogId      Int
  blog        Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@index([blogId])
}

model AdminSession {
  id            String   @id @default(uuid())
  token         String   @unique @db.VarChar(512)
  adminUsername String
  expiresAt     DateTime
  createdAt     DateTime @default(now())
}

model RoadmapProgress {
  id        Int      @id @default(autoincrement())
  taskId    String
  role      String   // "admin" or "visitor"
  completed Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([taskId, role])
}

model RoadmapJournal {
  id           Int      @id @default(autoincrement())
  weekId       String   // e.g. "week_1"
  role         String   // "admin" or "visitor"
  learned      String   @db.Text
  difficulties String   @db.Text
  notes        String   @db.Text
  updatedAt    DateTime @updatedAt

  @@unique([weekId, role])
}
