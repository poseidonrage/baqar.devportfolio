+
+    const driftConfig = [
+      { sx: -120, sy: 100, scale: 0.3 },    // block 1: bottom-left → down-left
+      { sx: -90, sy: 50, scale: 0.25 },     // block 2: mid-left → left
+      { sx: -60, sy: 130, scale: 0.3 },     // block 3: bottom-left → down
