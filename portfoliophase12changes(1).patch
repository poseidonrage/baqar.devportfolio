+        const cfg = driftConfig[i] || { sx: 0, sy: 0, scale: 0 };
+        const tx = cfg.sx * eased;
+        const ty = cfg.sy * eased;
+        const sc = 1 + (cfg.scale * eased);
+        wrap.style.transform = `translate3d(${tx}px, ${ty}px, 0) scale(${sc})`;
+      });
+    };
