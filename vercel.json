{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/roadmap",
      "destination": "/dist/index.html"
    },
    {
      "source": "/admin",
      "destination": "/dist/index.html"
    },
    {
      "source": "/blog/(.*)",
      "destination": "/dist/index.html"
    },
    {
      "source": "/blog",
      "destination": "/dist/index.html"
    },
    {
      "source": "/((?!api|dist/).*)",
      "destination": "/dist/$1"
    }
  ]
}
